# Dependencies
node_modules/

# Build output and caches
dist/
coverage/
*.tsbuildinfo
.vite/
.wrangler/

# Local settings and secrets. The example file shows what to fill in.
.env
.env.*
!.env.example

# Logs
*.log

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Downloaded by scripts/fetch-runtimes.mjs before dev and build
apps/app/public/runtimes/

# The signed desktop installer and latest.json, made by scripts/release-desktop.mjs
apps/app/public/desktop/
# The signed Android app and its latest.json, made by scripts/release-android.mjs
apps/app/public/android/
apps/app/android-aside/
# Bubblewrap makes the Android project from twa-manifest.json, so only that is kept.
apps/android/*
!apps/android/twa-manifest.json
