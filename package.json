{
  "name": "notemax",
  "version": "0.59.0",
  "description": "A local-first note app for writing that grows into books",
  "homepage": "https://notemax.pages.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaibhavshiroorkar/notemax.git"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @notemax/app dev",
    "desktop": "pnpm --filter @notemax/desktop dev",
    "build": "pnpm --filter @notemax/app build",
    "desktop:build": "pnpm --filter @notemax/desktop build",
    "typecheck": "pnpm -r typecheck",
    "version:set": "node scripts/set-version.mjs",
    "test": "pnpm -r test"
  }
}
