{
  "name": "notemax",
  "version": "0.121.0",
  "description": "A local-first note app for writing that grows into books",
  "homepage": "https://notemax.shiroorkar.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/vaibhavshiroorkar/notemax.git"
  },
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @notemax/app dev",
    "desktop": "pnpm --filter @notemax/desktop dev",
    "build": "pnpm --filter @notemax/app build",
    "site:deploy": "pnpm build && wrangler pages deploy apps/app/dist --project-name notemax --branch main",
    "desktop:build": "pnpm --filter @notemax/desktop build",
    "desktop:release": "node scripts/release-desktop.mjs",
    "android:release": "node scripts/release-android.mjs",
    "typecheck": "pnpm -r typecheck",
    "version:set": "node scripts/set-version.mjs",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "wrangler": "^4.163.0"
  }
}
