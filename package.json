{
  "name": "notemax",
  "version": "0.21.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @notemax/app dev",
    "desktop": "pnpm --filter @notemax/desktop dev",
    "build": "pnpm --filter @notemax/app build",
    "desktop:build": "pnpm --filter @notemax/desktop build",
    "typecheck": "pnpm -r typecheck",
    "version:set": "node scripts/set-version.mjs",
    "test": "pnpm -r test"
  }
}
