{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Notemax",
  "version": "0.1.0",
  "identifier": "com.notemax.app",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @notemax/app dev",
    "beforeBuildCommand": "pnpm --filter @notemax/app build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notemax",
        "width": 1200,
        "height": 800,
        "minWidth": 400,
        "minHeight": 300,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
