# Cloudflare Pages reads this file. See https://developers.cloudflare.com/pages/configuration/headers/
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), geolocation=(), microphone=(self)
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# File names under /assets/ change whenever their content does, so they can be kept for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker and the page must always be fresh, or an update would never arrive.
/sw.js
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# The desktop app asks for these to learn of new versions, so they must be fresh.
/desktop/latest.json
  Cache-Control: no-cache
/android/latest.json
  Cache-Control: no-cache

# The desktop app's Get the app tab reads the downloads from this site.
/desktop/*
  Access-Control-Allow-Origin: *
/android/*
  Access-Control-Allow-Origin: *
